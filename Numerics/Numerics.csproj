<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <Description>Numerics is a free and open-source .NET library developed by USACE-RMC, providing numerical methods, probability distributions, statistical analysis, optimization, machine learning, and Bayesian inference tools for quantitative risk assessment in water resources engineering.</Description>
    <Authors>C. Haden Smith; Woodrow L. Fields; Julian Gonzalez; Sadie Niblett; Brennan Beam; Brian Skahill</Authors>
    <PackageProjectUrl>https://github.com/USACE-RMC/Numerics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/USACE-RMC/Numerics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Title>Numerics</Title>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>USACE-RMC</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>numerical methods;statistics;probability distributions;hydrology;flood frequency analysis;copulas;L-moments;optimization;machine learning;Bayesian inference;MCMC;risk assessment</PackageTags>
    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageId>RMC.Numerics</PackageId>
  </PropertyGroup>

  <!-- Pack-time API compatibility check against the last public release on nuget.org. Advance the baseline after each release. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- System.ValueTuple is a .NET Framework 4.8.1 facade, so it is not among the net481 compile references; package validation needs it to compare net481 tuple signatures. -->
  <Target Name="AddValueTupleFacadeToPackageValidation" BeforeTargets="RunPackageValidation">
    <PropertyGroup>
      <_ValueTupleFacade Condition="'$(_ValueTupleFacade)' == ''">$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8.1\Facades\System.ValueTuple.dll</_ValueTupleFacade>
    </PropertyGroup>
    <ItemGroup>
      <PackageValidationReferencePath Condition="'%(Identity)' == 'net481' and Exists('$(_ValueTupleFacade)')" ReferencePath="%(ReferencePath),$(_ValueTupleFacade)" />
    </ItemGroup>
    <Message Importance="high" Condition="!Exists('$(_ValueTupleFacade)')" Text="Package validation: the .NET Framework 4.8.1 targeting pack was not found at '$(_ValueTupleFacade)', so the net481 comparison runs without System.ValueTuple and does not fully compare tuple signatures." />
  </Target>

  <!-- Otherwise targets C# 7.3 which doesn't have global usings and some other syntactic sugar utilized here.  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net481'">
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.3.0</Version>
    <PackageReleaseNotes>Version 2.3.0 adds Hosking-Wallis regional frequency analysis (Numerics.Distributions.Regional), Gaussian process regression, kriging, elastic net and PCA, the L-BFGS-B, CMA-ES and DDS optimizers with Pareto-front, dynamic programming and knapsack utilities, a QL eigensolver, an opt-in QAGS integrator, multi-source CSR shortest paths, column statistics, compensated sums, and per-element Poisson and Binomial array members. It fixes accuracy defects in StudentT, the incomplete beta and inverse incomplete gamma functions, the Joe, Clayton, Frank and Gumbel copula densities, GEV, Gamma and Pearson Type III L-moments, variance, covariance and Pearson correlation on offset data, and Kernel Density and Truncated modes. GoodnessOfFit.KolmogorovSmirnov and AndersonDarling now sort a copy of unsorted input, with new dataIsSorted overloads. GEV ParametersFromLinearMoments now throws for a non-positive L-scale, and Dijkstra and Network reject negative edge weights. The net10.0 build is tested on Windows and Linux, and the pynumerics Python package, which ships this assembly, is published to PyPI with each release. Breaking: the package targets net10.0 and net481 only; .NET 8 and .NET 9 reach end of support on November 10, 2026, so projects on those runtimes can stay on 2.2.0. See the v2.3.0 GitHub release notes for the full list and the results that move.</PackageReleaseNotes>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
  </PropertyGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>


	<ItemGroup>
		<!--https://github.com/dotnet/reproducible-builds-->
		<PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.39">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
    <!--https://github.com/dotnet/sourcelink/tree/main-->
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

   <!-- Conditional dependencies for .NET Framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="new-joe-kuo-6.21201" />
    <None Remove="Properties\new-joe-kuo-6.21201" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\new-joe-kuo-6.21201" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
