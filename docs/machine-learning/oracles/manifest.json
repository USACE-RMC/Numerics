{
  "hashConvention": "SHA-256 of UTF-8 text without BOM, CRLF normalized to LF",
  "environment": {
    "python": "3.14.3",
    "numpy": "2.4.2",
    "scipy": "1.17.1",
    "scikit-learn": "1.8.0",
    "R": "4.4.3",
    "glmnet": "4.1.10",
    "jsonlite": "2.0.0",
    "DiceKriging": "1.6.1",
    "gstat": "2.1.6",
    "sp": "2.2.1"
  },
  "generators": [
    {
      "script": "pca_oracle.py",
      "writes": [
        "pca-sklearn.json",
        "pca-random-matrix.csv"
      ],
      "reference": "scikit-learn PCA(svd_solver=\"full\")"
    },
    {
      "script": "pca_prcomp.R",
      "writes": [
        "pca-prcomp.txt"
      ],
      "reference": "R stats::prcomp",
      "note": "run as Rscript docs/machine-learning/oracles/pca_prcomp.R > docs/machine-learning/oracles/pca-prcomp.txt"
    },
    {
      "script": "enet_glmnet.R",
      "writes": [
        "enet-glmnet.json"
      ],
      "reference": "R glmnet and cv.glmnet, thresh = 1e-24"
    },
    {
      "script": "enet_sklearn.py",
      "writes": [
        "enet-sklearn.json"
      ],
      "reference": "scikit-learn ElasticNet and enet_path, tol = 1e-30",
      "requires": "enet-glmnet.json"
    },
    {
      "script": "gpr_sklearn_oracle.py",
      "writes": [
        "gpr-sklearn.json"
      ],
      "reference": "scikit-learn GaussianProcessRegressor (fixed hyperparameters and 50-restart fit)"
    },
    {
      "script": "gpr_dicekriging_oracle.R",
      "writes": [
        "gpr-dicekriging.json"
      ],
      "reference": "R DiceKriging km and predict.km(type = \"UK\"), leaveOneOut.km",
      "requires": "gpr-sklearn.json"
    },
    {
      "script": "kriging_gstat_oracle.R",
      "writes": [
        "kriging-gstat.json"
      ],
      "reference": "R gstat krige and krige.cv on sp::meuse; Isaaks and Srivastava (1989) chapter 12"
    }
  ],
  "data": [
    {
      "file": "docs/example-data/prostate-cancer.csv",
      "sha256Utf8Lf": "27b519a3303688ce6c4db9ab015158689da37dbca0893617ff8f1ddc59adb786"
    },
